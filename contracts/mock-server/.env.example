# Mock server configuration (all optional; defaults shown)
MOCK_HOST=0.0.0.0
MOCK_PORT=8000
# Comma-separated origins allowed to call the mock from a browser
MOCK_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
# Seconds between replayed findings on Socket.IO /events; 0 disables replay
MOCK_REPLAY_INTERVAL_S=10
# Seconds between scan.started and scan.finished after POST /api/scans
MOCK_SCAN_DELAY_S=2
# Directory holding schemas/ and mocks/ (defaults to the parent contracts/ folder)
# CONTRACTS_DIR=/app/contracts
LOG_LEVEL=INFO
