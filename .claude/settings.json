{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr ready:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stale-checkout-notice.js",
            "timeout": 30,
            "description": "Fetch origin/main and warn when this checkout is behind it (read-only, never merges or resets)"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/git-guard.js",
            "description": "Deny force/main pushes, reset --hard, amending a pushed commit, git add chained before commit; on commit deny staged .env, console.log in JS/TS, and service code with no active OpenSpec change"
          }
        ]
      }
    ]
  }
}
