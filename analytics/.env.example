# Copy to .env (untracked). Everything is optional except DATABASE_URL and REDIS_URL, which the worker needs
# (the CLI needs neither).
# CSV with KNF registry firms; defaults to registry/knf.csv, the real KNF register snapshot (see registry/README.md).
# registry/seed.csv holds 4 FICTIONAL firms for tests; the worker logs registry_seed when it is used.
REGISTRY_CSV=
LOG_LEVEL=INFO
# Supervisor and official-register domains (comma-separated, subdomains included): their pages never become M1/M3
# findings (reason official_source). Empty = knf.gov.pl,uknf.gov.pl,gov.pl; a value replaces that list.
OFFICIAL_SOURCE_DOMAINS=
# Only for tests: path to contracts/ so contract tests run instead of being skipped.
CONTRACTS_DIR=../contracts
# Only for tests: a throwaway Postgres whose role may CREATE DATABASE; the Postgres store tests are
# skipped without it. Example: docker run -d --rm --name iw-test-analytics-pg -e POSTGRES_PASSWORD=test
#   -p 127.0.0.1:55433:5432 public.ecr.aws/docker/library/postgres:17-alpine
TEST_DATABASE_URL=

# ---- worker (python -m investwatch_analytics.worker; analytics/compose.yaml builds the two URLs from the root .env)
# Required. App role, no DDL; the tables come from api-migrate.
DATABASE_URL=postgresql://iw_app:<POSTGRES_APP_PASSWORD>@postgres:5432/investwatch
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379/0
# Optional (defaults shown). Consumer name in group `analytics`: defaults to the hostname (container id).
WORKER_CONSUMER=
STREAM_BLOCK_MS=5000
CLAIM_MIN_IDLE_MS=60000
MAX_DELIVERIES=5
HEALTH_PORT=8001
# A bigger document (text + payload, bytes) is acked as invalid_document instead of risking an OOM kill.
MAX_DOCUMENT_BYTES=2000000
# LLM (ADR 0304, 0317): an OpenAI-compatible chat completions endpoint, env only. Empty LLM_BASE_URL = rules-only
# (model.llm = null). Hosted default (ADR 0317): Gemma 4 on the Gemini API (free quota, rate-limited; ~half the calls
# returned 503 "high demand" on 2026-11-21, 15-30 s per call):
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemma-4-31b-it
#   LLM_API_KEY=<Gemini API key, only in .env>
#   When 31b keeps returning 503 "high demand", switch to the tested alternative LLM_MODEL=gemma-4-26b-a4b-it
#   (2026-11-21: 31b 3/3 calls 503; 26b 3/5 calls 200 in 15-30 s, one 503, one 60 s timeout).
#   and raise the limits: LLM_TIMEOUT_S=45 LLM_DOC_BUDGET_S=50 CLAIM_MIN_IDLE_MS=90000
# Alternative hosted: LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=gpt-4o-mini  LLM_API_KEY=<secret>
# Local swap target (docker compose --profile llm up; ollama on the data network):
#   LLM_BASE_URL=http://ollama:11434/v1  LLM_MODEL=gemma3:4b  LLM_API_KEY=ollama
# A key is never sent over plain http to a non-local host (config error); the URL must not carry credentials.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Limits (defaults shown; ADR 0310). LLM_DOC_BUDGET_S + 3 s (the connect timeout) must stay below CLAIM_MIN_IDLE_MS.
LLM_TIMEOUT_S=20
LLM_DOC_BUDGET_S=40
LLM_CHUNK_CHARS=9000
LLM_MAX_CHUNKS=4
LLM_CACHE_TTL_S=604800
LLM_BREAKER_FAILURES=3
LLM_BREAKER_COOLDOWN_S=60
# Embeddings (ADR 0313): an OpenAI-compatible /embeddings endpoint, env only, LOCAL ONLY (no paid hosted API; the
# ADR 0304 mentor exception covers the LLM, not embeddings). Empty EMBED_BASE_URL = off: model.embedder = null and the
# topic gate runs on its dictionary. Local (docker compose --profile llm up, bge-m3 pulled by ollama-pull, issue #65;
# by hand: docker compose exec ollama ollama pull bge-m3):
#   EMBED_BASE_URL=http://ollama:11434/v1  EMBED_MODEL=bge-m3
# A key is never sent over plain http to a non-local host (config error); the URL must not carry credentials.
EMBED_BASE_URL=
EMBED_MODEL=bge-m3
EMBED_API_KEY=
# Limits (defaults shown). LLM_DOC_BUDGET_S + 3 s + EMBED_TIMEOUT_S must stay below CLAIM_MIN_IDLE_MS.
EMBED_DIM=1024
# 15 s: warm bge-m3 on a loaded 16-core CPU took 4-12 s per document; a cold load took 37 s (the first calls
# time out, the breaker opens, and after its 60 s cooldown the loaded model answers: pre-warm before a demo).
EMBED_TIMEOUT_S=15
EMBED_MAX_CHARS=4000
EMBED_CACHE_TTL_S=604800
EMBED_BREAKER_FAILURES=3
EMBED_BREAKER_COOLDOWN_S=60
# Topic gate (ADR 0314): drops third_party/unknown documents with no investment vocabulary (logged as off_topic,
# counted in Redis iw:stats:gate). firm_own pages are never gated. false = analyze everything.
GATE_ENABLED=true
# Only for the stretch similarity rescue (not built yet); calibrate on the gold set.
GATE_SIM_THRESHOLD=0.45
# Near-duplicates (ADR 0314): MinHash, 128 permutations = 32 bands x 4 rows, Jaccard >= 0.8, first 50k characters.
# A near-duplicate is analyzed as usual, joins its group, and does not fire a second finding.high_risk.
NEARDUP_NUM_PERM=128
NEARDUP_BANDS=32
NEARDUP_THRESHOLD=0.8
NEARDUP_MAX_CHARS=50000
NEARDUP_TTL_S=2592000
# Only for tests: a throwaway Redis; the real-Redis worker test is skipped without it.
TEST_REDIS_URL=
