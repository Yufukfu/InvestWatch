# Copy to .env (untracked). All settings are optional.
# CSV with KNF registry firms; defaults to registry/seed.csv (fictional firms).
REGISTRY_CSV=
LOG_LEVEL=INFO
# Only for tests: path to contracts/ so contract tests run instead of being skipped.
CONTRACTS_DIR=../contracts
# Only for tests: a throwaway Postgres whose role may CREATE DATABASE; the Postgres store tests are
# skipped without it. Example: docker run -d --rm --name iw-test-analytics-pg -e POSTGRES_PASSWORD=test
#   -p 127.0.0.1:55433:5432 public.ecr.aws/docker/library/postgres:17-alpine
TEST_DATABASE_URL=
