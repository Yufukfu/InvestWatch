{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "ignorePatterns": ["src/api/generated.ts", "public/mockServiceWorker.js", "dist"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "react/no-danger": "error",
    "no-console": "error",
    "no-eval": "error"
  },
  "overrides": [
    {
      "files": ["src/features/*/components/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              { "name": "react-redux" },
              { "name": "@reduxjs/toolkit" },
              { "name": "@reduxjs/toolkit/query" },
              { "name": "@reduxjs/toolkit/query/react" },
              { "name": "socket.io-client" }
            ],
            "patterns": [
              {
                "group": ["**/api", "**/api/**", "../data", "../data/**", "../../*/data", "../../*/data/**", "**/features/*/data", "**/features/*/data/**", "**/*Page", "**/store", "**/store.ts"],
                "message": "Presentational components take props only (ADR 0204). Read data in features/<name>/data/ and pass it down from the page."
              }
            ]
          }
        ]
      }
    }
  ]
}
