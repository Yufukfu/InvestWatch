{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "ignorePatterns": ["src/api/generated.ts", "public/mockServiceWorker.js", "dist"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "react/no-danger": "error",
    "no-console": "error",
    "no-eval": "error"
  },
  "overrides": [
    {
      "files": ["src/features/*/components/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/api",
                  "**/api/**",
                  "../**/data",
                  "../**/data/**",
                  "**/*Page",
                  "**/*Page.*",
                  "**/store",
                  "**/store.*",
                  "react-redux",
                  "react-redux/**",
                  "@reduxjs/toolkit",
                  "@reduxjs/toolkit/**",
                  "socket.io-client",
                  "socket.io-client/**"
                ],
                "message": "Presentational components take props only (ADR 0204): no api/, data/ (any relative path through a folder named data), pages, store, react-redux, @reduxjs/toolkit or socket.io-client. Read data in features/<name>/data/ and pass it down from the page."
              }
            ]
          }
        ]
      }
    }
  ]
}
