# web/ build-time settings (Vite inlines VITE_* into the bundle: never put secrets here).
VITE_API_BASE_URL=/api
# Socket.IO namespace URL for live alerts (path /socket.io)
VITE_EVENTS_URL=/events
# Dev server proxy target for /api and /socket.io (not shipped to the browser)
API_PROXY_TARGET=http://localhost:8000
