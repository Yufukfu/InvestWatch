# Run scripts/init-env.sh to create .env with random secrets (never commit .env).
# Passwords are empty on purpose: compose refuses to start until they are set.
# Hand-set secrets must be URL-safe (letters, digits, - _): they are embedded in REDIS_URL and the mc URL.
COMPOSE_PROJECT_NAME=investwatch

# Postgres (infra/compose.yaml)
POSTGRES_DB=investwatch
POSTGRES_ADMIN_USER=iw_admin
POSTGRES_ADMIN_PASSWORD=
POSTGRES_APP_USER=iw_app
POSTGRES_APP_PASSWORD=
# Services connect as: postgresql://iw_app:<POSTGRES_APP_PASSWORD>@postgres:5432/investwatch

# Gateway (single HTTPS entry point)
IW_HOSTNAME=localhost
IW_HTTPS_PORT=8443
IW_HTTP_PORT=8080
# HSTS off locally (it applies to every port of localhost); on a real domain: max-age=31536000; includeSubDomains
IW_HSTS=max-age=0
API_UPSTREAM=api:8000
WEB_UPSTREAM=web:8080

# Redis (infra/compose.yaml): stream iw:documents, pub/sub iw:events, key iw:settings:thresholds
REDIS_PASSWORD=
# Services connect as: REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379/0 (each module's compose.yaml builds it)

# Object storage, S3 API (infra/compose.yaml, ADR 0306). Root user: minio-init only, never services.
MINIO_ROOT_USER=iw-admin
MINIO_ROOT_PASSWORD=
# App user created by minio-init, limited to the bucket: what services use
MINIO_ACCESS_KEY=iw-app
MINIO_SECRET_KEY=
MINIO_BUCKET=iw-raw
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false

# LLM used by analytics (ADR 0304, 0318): a hosted OpenAI-compatible endpoint by default. Set these yourself;
# init-env.sh never generates them. Hosted default: LLM_BASE_URL=https://api.deepseek.com LLM_MODEL=deepseek-flash
# LLM_API_KEY=<DeepSeek key>, with LLM_TIMEOUT_S=60 LLM_DOC_BUDGET_S=90 CLAIM_MIN_IDLE_MS=120000 (analytics/.env.example).
# Alternatives by .env only: Gemma 4 on the Gemini API (ADR 0317) or local Ollama gemma3:4b (below).
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Local LLM fallback, only with --profile llm (ADR 0304)
# Models ollama-pull fetches, space-separated (not OLLAMA_MODELS: Ollama reads that as its storage directory): gemma3:4b (stage 2) and bge-m3 (embeddings, ADR 0313, ~1.2 GB)
OLLAMA_PULL_MODELS="gemma3:4b bge-m3"
# /v1 cannot set the context per request; a stage-2 chunk (~3k tokens + prompt) may exceed Ollama's default
OLLAMA_CONTEXT_LENGTH=8192
# Keep both models loaded side by side, for 30 minutes after the last request
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_KEEP_ALIVE=30m
# Then set: LLM_BASE_URL=http://ollama:11434/v1 LLM_MODEL=gemma3:4b LLM_API_KEY=ollama (any non-empty value)

# Opt-in host ports, loopback only: docker compose -f compose.yaml -f infra/compose.dev-ports.yaml up
IW_DEV_PG_PORT=15432
IW_DEV_REDIS_PORT=16379
IW_DEV_MINIO_PORT=19000

# API (api/compose.yaml): builds REDIS_URL from REDIS_PASSWORD and uses the MinIO app user above.
# Empty API_CORS_ORIGINS = same origin only (the gateway); a list REPLACES that default, so include the dashboard origin.
API_CORS_ORIGINS=

# Scraper (scraper/compose.yaml): worker, scheduler and a one-shot seed. Database, Redis and MinIO values come from above.
# Cron (5 fields, UTC) of the seeded KNF source; an invalid value makes seed fail and the scraper not start.
SCRAPER_SEED_CRON=0 */6 * * *
# First run: queue one scan for every scheduled source that never ran (true or false). Off = cron only.
BOOTSTRAP_SCAN=true
# Render firm_own M2 pages for the visual rules R4/R6 (screenshots, blocks). Off: R4/R6 stay not_applicable. See scraper/README.md before turning it on.
SCRAPER_RENDER_ENABLED=false
# Optional proxies, comma separated; may hold credentials, so set them in .env only, never here.
PROXY_LIST=
PROXY_ROTATION=per_request
PROXY_COOLDOWN_SECONDS=90
# Politeness and limits per fetch; defaults documented in scraper/.env.example
DOMAIN_MIN_INTERVAL_SECONDS=5
FETCH_TIMEOUT_SECONDS=20
FETCH_MAX_BYTES=5242880
ALLOWED_PORTS=80,443
COMPOSE_INTERNAL_HOSTS=
FETCH_EXTRA_HOSTS=
# X and YouTube collectors (ADR 0109). The cookies of a dedicated X account and the residential proxy URL for
# transcripts are credentials: set them in .env only, never here. Unset X cookies end an X run as invalid_request;
# an unset proxy turns transcripts off.
X_AUTH_TOKEN=
X_CT0=
YT_TRANSCRIPT_PROXY=
YOUTUBE_MAX_VIDEOS=10
# SIGTERM: finish running jobs for this long (compose waits 60 s, so keep it at 30 or less)
SCRAPER_SHUTDOWN_DEADLINE=30
SCRAPER_HEALTH_PORT=8080
