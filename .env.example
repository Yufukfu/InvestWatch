# Run scripts/init-env.sh to create .env with random secrets (never commit .env).
# Passwords are empty on purpose: compose refuses to start until they are set.
COMPOSE_PROJECT_NAME=investwatch

# Postgres (infra/compose.yaml)
POSTGRES_DB=investwatch
POSTGRES_ADMIN_USER=iw_admin
POSTGRES_ADMIN_PASSWORD=
POSTGRES_APP_USER=iw_app
POSTGRES_APP_PASSWORD=
# Services connect as: postgresql://iw_app:<POSTGRES_APP_PASSWORD>@postgres:5432/investwatch

# Gateway (single HTTPS entry point)
IW_HOSTNAME=localhost
IW_HTTPS_PORT=8443
IW_HTTP_PORT=8080
# HSTS off locally (it applies to every port of localhost); on a real domain: max-age=31536000; includeSubDomains
IW_HSTS=max-age=0
API_UPSTREAM=api:8000
WEB_UPSTREAM=web:8080

# API (api/compose.yaml). It also needs REDIS_URL, MINIO_ACCESS_KEY and MINIO_SECRET_KEY (compose refuses to start
# without them; provided with Redis and MinIO by the infra-compose change) and takes MINIO_ENDPOINT, MINIO_BUCKET,
# MINIO_SECURE and LOG_LEVEL. Empty API_CORS_ORIGINS = same origin only (the gateway); a list REPLACES that default,
# so include the dashboard origin.
API_CORS_ORIGINS=
