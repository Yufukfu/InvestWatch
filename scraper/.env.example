# scraper/ settings. Shared values (REDIS_URL, DATABASE_URL, MINIO_*) come from the root .env.
REDIS_URL=redis://redis:6379/0

# Optional. Unset means: hostname / <repo>/contracts.
# SCRAPER_CONSUMER=worker-1
# CONTRACTS_DIR=/app/contracts

# Optional tuning, one SCRAPER_<FIELD> per setting; the value shown is the default (seconds unless noted).
# Queue (iw_scraper.jobs.QueueSettings)
# SCRAPER_MAX_TRIES=3                  # failed attempts per job (timeout, HTTP 5xx) before one job error
# SCRAPER_BACKOFF_BASE=2.0
# SCRAPER_BACKOFF_CAP=300.0
# SCRAPER_ATTEMPT_TIMEOUT=60.0         # one attempt; over it counts as a timeout failure
# SCRAPER_DOMAIN_CONCURRENCY=2         # jobs running at once per domain, across all workers
# SCRAPER_LEASE_TTL=30.0               # run lock and concurrency lease; a crashed worker's expire
# SCRAPER_REQUEUE_DELAY=5.0
# SCRAPER_FAILURE_THRESHOLD=5          # consecutive failed jobs that pause a domain
# SCRAPER_DOMAIN_COOLDOWN=300.0
# Worker process (iw_scraper.worker.RunnerSettings)
# SCRAPER_MAX_JOBS=10
# SCRAPER_SHUTDOWN_DEADLINE=30.0       # SIGTERM: finish running jobs, then requeue the rest
# SCRAPER_RECONNECT_BASE=1.0
# SCRAPER_RECONNECT_CAP=30.0
# SCRAPER_POLL_DELAY=0.5
# SCRAPER_CONSUMER_BLOCK=1.0
