# Defaults of the scraper (see scraper/README.md). Copy to .env; never commit real proxy URLs.
PROXY_LIST=
PROXY_ROTATION=per_request
PROXY_COOLDOWN_SECONDS=90
REDIS_URL=redis://localhost:6379/0
DOMAIN_MIN_INTERVAL_SECONDS=5
MAX_RETRY_AFTER_SECONDS=300
DOMAIN_FAILURE_THRESHOLD=5
DOMAIN_PAUSE_SECONDS=600
FETCH_TIMEOUT_SECONDS=20
FETCH_MAX_BYTES=5242880
ALLOWED_PORTS=80,443
COMPOSE_INTERNAL_HOSTS=
FETCH_EXTRA_HOSTS=
